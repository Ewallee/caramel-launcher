// Caramel Launcher theme: Cimmeria, cold steel: blue-grey stone and steel accents.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Cimmeria",                           // theme name in Settings
  "Variant": "Dark",                            // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#121518",                // window
  "RailBackground": "#0c0e10",                  // title bar, side menu, text fields
  "SurfaceBackground": "#161a1e",               // cards
  "SurfaceBorder": "#262d34",                   // card and field borders
  "PanelBackground": "#1c2126",                 // dark buttons, panels
  "PanelHover": "#252b32",                      // dark button under the mouse
  "PanelBorder": "#333c46",                     // dark button border
  "InputHoverBorder": "#44515d",                // text field border under the mouse
  "ActiveBackground": "#18253a",                // card of the active game version
  "WarningBackground": "#242a30",               // warning box
  "WarningBorder": "#4a5864",                   // warning box border

  // Text
  "TextPrimary": "#dde3ea",                     // normal text
  "TextTitle": "#eef2f6",                       // headings, names
  "TextSection": "#c3cdd8",                     // section labels, dark button labels
  "TextSecondary": "#9aa5b1",                   // descriptions
  "TextMuted": "#6f7b87",                       // mod size and date, status bar
  "TextDim": "#535c66",                         // faint labels
  "TextFaint": "#404850",                       // faintest labels
  "TextBright": "#f7f4ef",                      // text on colored buttons

  // Accents
  "AccentGold": "#8fa9c2",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#b3cbe0",                // favorite star, dark button icons
  "AccentPurple": "#3d6fa8",                    // main action button
  "AccentPurpleHover": "#4b81be",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#8fb8ff",                  // Enhanced icon
  "NavText": "#c3cad2",                         // menu items
  "NavTextActive": "#eef2f6",                   // selected menu item
  "NavHover": "#11181f",                        // menu item under the mouse
  "NavActive": "#172331",                       // selected menu item background
  "NavActiveBorder": "#2d517b",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#6fae5a",                     // Play, active version, checkboxes
  "AccentGreenLight": "#a5cc98",                // green under the mouse, done messages
  "GoButton": "#5d9649",                        // green Play button
  "GoButtonHover": "#67a752",                   // green Play button under the mouse
  "GreenBadge": "#263727",                      // loaded badge
  "Danger": "#d9584a",                          // remove, delete
  "DangerHover": "#cf3b2b",                     // window close button under the mouse
  "DropTarget": "#5b9cf6",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#263727",         // filter on
  "FilterIncludeText": "#93c283",               // filter on, icon
  "FilterIncludeHoverBackground": "#30462d",    // filter on, under the mouse
  "FilterIncludeHoverText": "#abd09e",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#3a2222",         // filter excluded
  "FilterExcludeText": "#e27f74",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#4e2927",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#e99e96",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#e8e6df",                     // light button
  "LightButtonHover": "#eeede8",                // light button under the mouse
  "LightButtonText": "#202020",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#38414b",              // thumb
  "ScrollBarThumbFillPointerOver": "#4a5864",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#5d6e7e",       // thumb while dragging
  "ScrollBarTrackFill": "#0c0e10",              // track
}
