// Caramel Launcher theme: Frost, light and icy: frost on glass, ice blue and deep blue.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Frost",                              // theme name in Settings
  "Variant": "Light",                           // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#e0eaf9",                // window
  "RailBackground": "#cfddf5",                  // title bar, side menu, text fields
  "SurfaceBackground": "#f0f5fd",               // cards
  "SurfaceBorder": "#b6cbee",                   // card and field borders
  "PanelBackground": "#d7e4f8",                 // dark buttons, panels
  "PanelHover": "#c6d8f5",                      // dark button under the mouse
  "PanelBorder": "#9db9e8",                     // dark button border
  "InputHoverBorder": "#7ca2e1",                // text field border under the mouse
  "ActiveBackground": "#c9dbf6",                // card of the active game version
  "WarningBackground": "#f6ecd6",               // warning box
  "WarningBorder": "#d9c08f",                   // warning box border

  // Text
  "TextPrimary": "#0f2448",                     // normal text
  "TextTitle": "#0a1c3c",                       // headings, names
  "TextSection": "#1f3d6e",                     // section labels, dark button labels
  "TextSecondary": "#3a5282",                   // descriptions
  "TextMuted": "#566c96",                       // mod size and date, status bar
  "TextDim": "#7f92b4",                         // faint labels
  "TextFaint": "#9babc8",                       // faintest labels
  "TextBright": "#ffffff",                      // text on colored buttons

  // Accents
  "AccentGold": "#3a68b4",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#0a62c0",                // favorite star, dark button icons
  "AccentPurple": "#1c4c98",                    // main action button
  "AccentPurpleHover": "#153d80",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#5a52c8",                  // Enhanced icon
  "NavText": "#1f3d6e",                         // menu items
  "NavTextActive": "#0a1c3c",                   // selected menu item
  "NavHover": "#d6e3f8",                        // menu item under the mouse
  "NavActive": "#bcd1f3",                       // selected menu item background
  "NavActiveBorder": "#1c4c98",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#4f8a2b",                     // Play, active version, checkboxes
  "AccentGreenLight": "#274415",                // green under the mouse, done messages
  "GoButton": "#3d6b21",                        // green Play button
  "GoButtonHover": "#487e27",                   // green Play button under the mouse
  "GreenBadge": "#c3d7d0",                      // loaded badge
  "Danger": "#c0392b",                          // remove, delete
  "DangerHover": "#9f2f24",                     // window close button under the mouse
  "DropTarget": "#0070d0",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#c0d5cc",         // filter on
  "FilterIncludeText": "#345b1c",               // filter on, icon
  "FilterIncludeHoverBackground": "#b2cbb7",    // filter on, under the mouse
  "FilterIncludeHoverText": "#223c13",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#dac7d0",         // filter excluded
  "FilterExcludeText": "#962d22",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#d6b5bb",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#75231a",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#d0def5",                     // light button
  "LightButtonHover": "#c3d5f2",                // light button under the mouse
  "LightButtonText": "#0f2448",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#a8c0ea",              // thumb
  "ScrollBarThumbFillPointerOver": "#8eacdf",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#7898d4",       // thumb while dragging
  "ScrollBarTrackFill": "#d7e4f8",              // track
}
