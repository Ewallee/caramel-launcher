// Caramel Launcher theme: Red Rift, dark: black and steel, active things in blood red.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Red Rift",                           // theme name in Settings
  "Variant": "Dark",                            // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#0b0909",                // window
  "RailBackground": "#060505",                  // title bar, side menu, text fields
  "SurfaceBackground": "#120d0d",               // cards
  "SurfaceBorder": "#2c1717",                   // card and field borders
  "PanelBackground": "#1a1111",                 // dark buttons, panels
  "PanelHover": "#261919",                      // dark button under the mouse
  "PanelBorder": "#402222",                     // dark button border
  "InputHoverBorder": "#5b3030",                // text field border under the mouse
  "ActiveBackground": "#260b0c",                // card of the active game version
  "WarningBackground": "#2a1208",               // warning box
  "WarningBorder": "#6b3a1e",                   // warning box border

  // Text
  "TextPrimary": "#e8e4e2",                     // normal text
  "TextTitle": "#f4f1ef",                       // headings, names
  "TextSection": "#d0d0d0",                     // section labels, dark button labels
  "TextSecondary": "#aaa4a2",                   // descriptions
  "TextMuted": "#7c7472",                       // mod size and date, status bar
  "TextDim": "#5a5452",                         // faint labels
  "TextFaint": "#443e3e",                       // faintest labels
  "TextBright": "#f7f4ef",                      // text on colored buttons

  // Accents
  "AccentGold": "#b8b8b8",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#e5392f",                // favorite star, dark button icons
  "AccentPurple": "#8f1219",                    // main action button
  "AccentPurpleHover": "#a8171f",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#ff4d45",                  // Enhanced icon
  "NavText": "#cfcaca",                         // menu items
  "NavTextActive": "#f4f1ef",                   // selected menu item
  "NavHover": "#160404",                        // menu item under the mouse
  "NavActive": "#2a0404",                       // selected menu item background
  "NavActiveBorder": "#6b0000",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#d4262e",                     // Play, active version, checkboxes
  "AccentGreenLight": "#ff6a60",                // green under the mouse, done messages
  "GoButton": "#b3121b",                        // green Play button
  "GoButtonHover": "#cc1a24",                   // green Play button under the mouse
  "GreenBadge": "#3a0e10",                      // loaded badge
  "Danger": "#e5392f",                          // remove, delete
  "DangerHover": "#d1241a",                     // window close button under the mouse
  "DropTarget": "#5b9cf6",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#3a0e10",         // filter on
  "FilterIncludeText": "#ff8a80",               // filter on, icon
  "FilterIncludeHoverBackground": "#4d1215",    // filter on, under the mouse
  "FilterIncludeHoverText": "#ffa39b",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#371311",         // filter excluded
  "FilterExcludeText": "#eb645c",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#4c1714",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#ef8781",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#e8e6df",                     // light button
  "LightButtonHover": "#eeede8",                // light button under the mouse
  "LightButtonText": "#202020",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#3f3d3d",              // thumb
  "ScrollBarThumbFillPointerOver": "#595858",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#737272",       // thumb while dragging
  "ScrollBarTrackFill": "#060505",              // track

  // Switch and play button
  "SwitchButton": "#55555d",                    // Switch and play button
  "SwitchButtonHover": "#66666f",               // Switch and play button under the mouse
}
