// Caramel Launcher theme: Light, parchment and lavender.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Light",                              // theme name in Settings
  "Variant": "Light",                           // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#f6f4ee",                // window
  "RailBackground": "#e8e6df",                  // title bar, side menu, text fields
  "SurfaceBackground": "#faf9f6",               // cards
  "SurfaceBorder": "#d6d3cb",                   // card and field borders
  "PanelBackground": "#e9e8e2",                 // dark buttons, panels
  "PanelHover": "#dfdcd3",                      // dark button under the mouse
  "PanelBorder": "#cfcbc2",                     // dark button border
  "InputHoverBorder": "#b3aea4",                // text field border under the mouse
  "ActiveBackground": "#e7e1e9",                // card of the active game version
  "WarningBackground": "#f6ecd6",               // warning box
  "WarningBorder": "#d9c08f",                   // warning box border

  // Text
  "TextPrimary": "#202020",                     // normal text
  "TextTitle": "#1c1a17",                       // headings, names
  "TextSection": "#3d3833",                     // section labels, dark button labels
  "TextSecondary": "#5c5c5c",                   // descriptions
  "TextMuted": "#76716a",                       // mod size and date, status bar
  "TextDim": "#8f8a82",                         // faint labels
  "TextFaint": "#a8a39b",                       // faintest labels
  "TextBright": "#ffffff",                      // text on colored buttons

  // Accents
  "AccentGold": "#967434",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#a8741a",                // favorite star, dark button icons
  "AccentPurple": "#7e57c2",                    // main action button
  "AccentPurpleHover": "#6a45ad",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#8e44b8",                  // Enhanced icon
  "NavText": "#3d3833",                         // menu items
  "NavTextActive": "#202020",                   // selected menu item
  "NavHover": "#e3dfe6",                        // menu item under the mouse
  "NavActive": "#d9d2db",                       // selected menu item background
  "NavActiveBorder": "#7e57c2",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#5b8c2a",                     // Play, active version, checkboxes
  "AccentGreenLight": "#3f7a1e",                // green under the mouse, done messages
  "GoButton": "#5b8c2a",                        // green Play button
  "GoButtonHover": "#4c7a22",                   // green Play button under the mouse
  "GreenBadge": "#dcebd0",                      // loaded badge
  "Danger": "#c0392b",                          // remove, delete
  "DangerHover": "#c42b1c",                     // window close button under the mouse
  "DropTarget": "#3b7dd8",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#dcebd5",         // filter on
  "FilterIncludeText": "#3d7a33",               // filter on, icon
  "FilterIncludeHoverBackground": "#cfe3c5",    // filter on, under the mouse
  "FilterIncludeHoverText": "#2f6327",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#f3dcdc",         // filter excluded
  "FilterExcludeText": "#a94442",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#ecc9c9",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#8e3331",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#e3dfd6",                     // light button
  "LightButtonHover": "#d9d4c9",                // light button under the mouse
  "LightButtonText": "#202020",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#cfcac0",              // thumb
  "ScrollBarThumbFillPointerOver": "#b8b2a6",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#a39c8f",       // thumb while dragging
  "ScrollBarTrackFill": "#ece9e2",              // track
}
