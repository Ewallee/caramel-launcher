// Caramel Launcher theme: Night Wolf, moonlit night: silver, lavender mist and violet.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Night Wolf",                         // theme name in Settings
  "Variant": "Dark",                            // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#1c1b27",                // window
  "RailBackground": "#14131d",                  // title bar, side menu, text fields
  "SurfaceBackground": "#232233",               // cards
  "SurfaceBorder": "#383650",                   // card and field borders
  "PanelBackground": "#3a3857",                 // dark buttons, panels
  "PanelHover": "#46446a",                      // dark button under the mouse
  "PanelBorder": "#55527a",                     // dark button border
  "InputHoverBorder": "#56537b",                // text field border under the mouse
  "ActiveBackground": "#3a3358",                // card of the active game version
  "WarningBackground": "#2c2418",               // warning box
  "WarningBorder": "#6e5a3a",                   // warning box border

  // Text
  "TextPrimary": "#eceaf2",                     // normal text
  "TextTitle": "#f8f6f0",                       // headings, names
  "TextSection": "#cfc6e0",                     // section labels, dark button labels
  "TextSecondary": "#b4b0c4",                   // descriptions
  "TextMuted": "#9a96ae",                       // mod size and date, status bar
  "TextDim": "#7e7a93",                         // faint labels
  "TextFaint": "#6c6981",                       // faintest labels
  "TextBright": "#f7f4ef",                      // text on colored buttons

  // Accents
  "AccentGold": "#b8b0c8",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#a888d8",                // favorite star, dark button icons
  "AccentPurple": "#7458b8",                    // main action button
  "AccentPurpleHover": "#8468c8",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#a888d8",                  // Enhanced icon
  "NavText": "#d2cfdc",                         // menu items
  "NavTextActive": "#f8f6f0",                   // selected menu item
  "NavHover": "#1e1a2c",                        // menu item under the mouse
  "NavActive": "#29223f",                       // selected menu item background
  "NavActiveBorder": "#a888d8",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#7aa86a",                     // Play, active version, checkboxes
  "AccentGreenLight": "#aecaa4",                // green under the mouse, done messages
  "GoButton": "#4f7d44",                        // green Play button
  "GoButtonHover": "#5b8c4f",                   // green Play button under the mouse
  "GreenBadge": "#313a36",                      // loaded badge
  "Danger": "#e0607a",                          // remove, delete
  "DangerHover": "#d93e5d",                     // window close button under the mouse
  "DropTarget": "#5b9cf6",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#313a36",         // filter on
  "FilterIncludeText": "#9cbf91",               // filter on, icon
  "FilterIncludeHoverBackground": "#3a483c",    // filter on, under the mouse
  "FilterIncludeHoverText": "#b3ceaa",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#432938",         // filter excluded
  "FilterExcludeText": "#e88b9e",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#573040",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#efadba",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#e8e6df",                     // light button
  "LightButtonHover": "#eeede8",                // light button under the mouse
  "LightButtonText": "#202020",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#4b4857",              // thumb
  "ScrollBarThumbFillPointerOver": "#625e6f",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#7a7488",       // thumb while dragging
  "ScrollBarTrackFill": "#14131d",              // track

  // Version cards (optional: without them the cards use SurfaceBackground and ActiveBackground)
  "CardLight": "#48446a",                       // center of the version cards
  "CardShade": "#2c2a42",                       // edges of the version cards
  "CardGlow": "#70b8b0e0",                      // glow around the version cards, #aarrggbb, #00000000 = none
}
