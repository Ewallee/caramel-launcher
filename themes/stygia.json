// Caramel Launcher theme: Stygia, the queen and her cat: obsidian, gold, turquoise and green cat eyes.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Stygia",                             // theme name in Settings
  "Variant": "Dark",                            // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#100d09",                // window
  "RailBackground": "#0a0806",                  // title bar, side menu, text fields
  "SurfaceBackground": "#17120c",               // cards
  "SurfaceBorder": "#3b2e1a",                   // card and field borders
  "PanelBackground": "#231b10",                 // dark buttons, panels
  "PanelHover": "#302414",                      // dark button under the mouse
  "PanelBorder": "#5c4524",                     // dark button border
  "InputHoverBorder": "#8c6a30",                // text field border under the mouse
  "ActiveBackground": "#2a2012",                // card of the active game version
  "WarningBackground": "#2c2416",               // warning box
  "WarningBorder": "#7a6030",                   // warning box border

  // Text
  "TextPrimary": "#f0e4cb",                     // normal text
  "TextTitle": "#ffe7b0",                       // headings, names
  "TextSection": "#e6c88a",                     // section labels, dark button labels
  "TextSecondary": "#cbb489",                   // descriptions
  "TextMuted": "#a8916a",                       // mod size and date, status bar
  "TextDim": "#86714f",                         // faint labels
  "TextFaint": "#6c5b40",                       // faintest labels
  "TextBright": "#fff8e8",                      // text on colored buttons

  // Accents
  "AccentGold": "#e0ae48",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#f5c95e",                // favorite star, dark button icons
  "AccentPurple": "#177872",                  // main action button
  "AccentPurpleHover": "#27a8a2",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#3cc4b8",                  // Enhanced icon
  "NavText": "#e2d0a8",                         // menu items
  "NavTextActive": "#ffefc8",                   // selected menu item
  "NavHover": "#1b150d",                        // menu item under the mouse
  "NavActive": "#2b2112",                       // selected menu item background
  "NavActiveBorder": "#e0ae48",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#8fd640",                     // Play, active version, checkboxes
  "AccentGreenLight": "#bdeb86",                // green under the mouse, done messages
  "GoButton": "#437e1c",                      // green Play button
  "GoButtonHover": "#5ca82a",                   // green Play button under the mouse
  "GreenBadge": "#25331a",                      // loaded badge
  "Danger": "#e0644c",                          // remove, delete
  "DangerHover": "#d4452c",                     // window close button under the mouse
  "DropTarget": "#3cc4b8",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#25331a",         // filter on
  "FilterIncludeText": "#a6db70",               // filter on, icon
  "FilterIncludeHoverBackground": "#2f4122",    // filter on, under the mouse
  "FilterIncludeHoverText": "#bfe890",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#3b2217",         // filter excluded
  "FilterExcludeText": "#ef9278",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#50291b",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#f5b09c",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#eddcb4",                     // light button
  "LightButtonHover": "#f6e9c8",                // light button under the mouse
  "LightButtonText": "#1e160a",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#4a3b22",              // thumb
  "ScrollBarThumbFillPointerOver": "#67522c",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#8a6c38",       // thumb while dragging
  "ScrollBarTrackFill": "#0a0806",              // track

  // Version cards (optional: without them the cards use SurfaceBackground and ActiveBackground)
  "CardLight": "#3b2b14",                       // center of the version cards
  "CardShade": "#140f09",                       // edges of the version cards
  "CardGlow": "#80e0ae48",                      // glow around the version cards, #aarrggbb, #00000000 = none
}
