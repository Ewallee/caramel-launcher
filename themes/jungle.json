// Caramel Launcher theme: Jungle, the forests of Kush: deep green, brass and a copper main button.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Jungle",                             // theme name in Settings
  "Variant": "Dark",                            // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#0f1411",                // window
  "RailBackground": "#0a0e0b",                  // title bar, side menu, text fields
  "SurfaceBackground": "#131a16",               // cards
  "SurfaceBorder": "#22302a",                   // card and field borders
  "PanelBackground": "#18221d",                 // dark buttons, panels
  "PanelHover": "#202e27",                      // dark button under the mouse
  "PanelBorder": "#2f423a",                     // dark button border
  "InputHoverBorder": "#405a4f",                // text field border under the mouse
  "ActiveBackground": "#15291d",                // card of the active game version
  "WarningBackground": "#29281b",               // warning box
  "WarningBorder": "#635532",                   // warning box border

  // Text
  "TextPrimary": "#e3eadf",                     // normal text
  "TextTitle": "#eef4e6",                       // headings, names
  "TextSection": "#cddcb8",                     // section labels, dark button labels
  "TextSecondary": "#9fae98",                   // descriptions
  "TextMuted": "#71806c",                       // mod size and date, status bar
  "TextDim": "#546051",                         // faint labels
  "TextFaint": "#404a3e",                       // faintest labels
  "TextBright": "#f7f4ef",                      // text on colored buttons

  // Accents
  "AccentGold": "#c9a55a",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#ddb96a",                // favorite star, dark button icons
  "AccentPurple": "#9e5f27",                    // main action button
  "AccentPurpleHover": "#ba702f",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#8fd6a8",                  // Enhanced icon
  "NavText": "#c5cfbf",                         // menu items
  "NavTextActive": "#eef4e6",                   // selected menu item
  "NavHover": "#1a170e",                        // menu item under the mouse
  "NavActive": "#2d2112",                       // selected menu item background
  "NavActiveBorder": "#77481e",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#8cbf4a",                     // Play, active version, checkboxes
  "AccentGreenLight": "#b7d78e",                // green under the mouse, done messages
  "GoButton": "#618830",                        // green Play button
  "GoButtonHover": "#6c9735",                   // green Play button under the mouse
  "GreenBadge": "#2b3a1e",                      // loaded badge
  "Danger": "#d9584a",                          // remove, delete
  "DangerHover": "#cf3b2b",                     // window close button under the mouse
  "DropTarget": "#5b9cf6",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#2b3a1e",         // filter on
  "FilterIncludeText": "#a9cf77",               // filter on, icon
  "FilterIncludeHoverBackground": "#374b23",    // filter on, under the mouse
  "FilterIncludeHoverText": "#bcda95",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#37221c",         // filter excluded
  "FilterExcludeText": "#e27f74",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#4c2822",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#e99e96",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#e8e6df",                     // light button
  "LightButtonHover": "#eeede8",                // light button under the mouse
  "LightButtonText": "#202020",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#473f27",              // thumb
  "ScrollBarThumbFillPointerOver": "#635532",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#7f6b3d",       // thumb while dragging
  "ScrollBarTrackFill": "#0a0e0b",              // track
}
