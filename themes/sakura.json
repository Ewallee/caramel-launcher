// Caramel Launcher theme: Sakura, light pink: cherry blossom, orchid purple and a green Play.
// Colors: #rrggbb or #aarrggbb. A missing line uses the built-in color.
// Changes apply as soon as you save.
{
  "Name": "Sakura",                             // theme name in Settings
  "Variant": "Light",                           // Light or Dark: text, checkboxes, lists and tooltips of standard controls

  // Backgrounds
  "WindowBackground": "#f0e0e8",                // window
  "RailBackground": "#e6d0dc",                  // title bar, side menu, text fields
  "SurfaceBackground": "#f8eef3",               // cards
  "SurfaceBorder": "#dcc4d1",                   // card and field borders
  "PanelBackground": "#ecd8e2",                 // dark buttons, panels
  "PanelHover": "#e5cad8",                      // dark button under the mouse
  "PanelBorder": "#d1b1c2",                     // dark button border
  "InputHoverBorder": "#c197ae",                // text field border under the mouse
  "ActiveBackground": "#eed3ea",                // card of the active game version
  "WarningBackground": "#f6e6d8",               // warning box
  "WarningBorder": "#d6a98a",                   // warning box border

  // Text
  "TextPrimary": "#30202c",                     // normal text
  "TextTitle": "#2a1826",                       // headings, names
  "TextSection": "#5a3a58",                     // section labels, dark button labels
  "TextSecondary": "#6e5e6a",                   // descriptions
  "TextMuted": "#8a7a86",                       // mod size and date, status bar
  "TextDim": "#a999a3",                         // faint labels
  "TextFaint": "#bdadb7",                       // faintest labels
  "TextBright": "#ffffff",                      // text on colored buttons

  // Accents
  "AccentGold": "#b8508a",                      // menu icons, Legacy, links, search
  "AccentGoldBright": "#b4449e",                // favorite star, dark button icons
  "AccentPurple": "#983ca4",                    // main action button
  "AccentPurpleHover": "#802c90",               // main action button under the mouse, progress bars
  "AccentEnhanced": "#b4449e",                  // Enhanced icon
  "NavText": "#4a3446",                         // menu items
  "NavTextActive": "#2a1826",                   // selected menu item
  "NavHover": "#ead5e1",                        // menu item under the mouse
  "NavActive": "#e2c4da",                       // selected menu item background
  "NavActiveBorder": "#983ca4",                 // selected menu item stripe

  // Green, red, blue
  "AccentGreen": "#3f9a5e",                     // Play, active version, checkboxes
  "AccentGreenLight": "#2f7d4a",                // green under the mouse, done messages
  "GoButton": "#44a064",                        // green Play button
  "GoButtonHover": "#3a8f58",                   // green Play button under the mouse
  "GreenBadge": "#cdd2cc",                      // loaded badge
  "Danger": "#c0392b",                          // remove, delete
  "DangerHover": "#9f2f24",                     // window close button under the mouse
  "DropTarget": "#8a5cd8",                      // drop place when dragging a mod

  // Server tag filters
  "FilterIncludeBackground": "#c9d1ca",         // filter on
  "FilterIncludeText": "#2d6f43",               // filter on, icon
  "FilterIncludeHoverBackground": "#b7cabc",    // filter on, under the mouse
  "FilterIncludeHoverText": "#215232",          // filter on, icon under the mouse
  "FilterExcludeBackground": "#e6bfc2",         // filter excluded
  "FilterExcludeText": "#962d22",               // filter excluded, icon
  "FilterExcludeHoverBackground": "#e2aeaf",    // filter excluded, under the mouse
  "FilterExcludeHoverText": "#75231a",          // filter excluded, icon under the mouse

  // Light buttons
  "LightButton": "#e7d3de",                     // light button
  "LightButtonHover": "#e2c9d7",                // light button under the mouse
  "LightButtonText": "#30202c",                 // light button text
  "KillButton": "#ad8413",                      // Kill process button
  "KillButtonHover": "#947113",                 // Kill process button under the mouse

  // Scrollbar
  "ScrollBarThumbFill": "#dcbfd0",              // thumb
  "ScrollBarThumbFillPointerOver": "#cfa8bf",   // thumb under the mouse
  "ScrollBarThumbFillPressed": "#c093ae",       // thumb while dragging
  "ScrollBarTrackFill": "#e6d0dc",              // track
}
